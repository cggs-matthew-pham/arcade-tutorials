G^hst:V=-"><field name="TEXT">World</field></shadow><block type="variables_get" id="=8*]|Jz8^jh(XuA9%lqL"><field name="VAR" id="!ihY]nAys!JOOhpy[qih">numHungryStudents</field></block></value><value name="ADD2"><shadow type="text" id="5O=h9FA5U_y3x{!0Zlx0"><field name="TEXT"> hungry students in this class!</field></shadow></value></block></value></block></statement><next><block type="game_show_long_text" id="Kl|!a_brj[$vb?hUt1Yn"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="FFk)d_olw`m*p;C^u=})"><field name="TEXT">What can we do to make sure EVERYONE in the world has enough to eat?</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="OKuHn!gaZ1~5m(.%(+fk" x="0" y="0"><mutation name="WelcomeToOzHarvest" functionid="|^@3!]3i{7!em?)KQ]VO"></mutation><field name="function_name">WelcomeToOzHarvest</field><comment pinned="true" h="589" w="383">An OzHarvest image was copied into the background by using:
https://kristianpedersen.github.io/Convert-Image-to-MakeCode-Arcade-Sprite/

A series of long text blocks are used to tell the player about OzHarvest.

Then a player choices block is used to quiz the player. 
- IF they select the right answer, their score increases by one and a "correct" message is shown
- ELSE, it tells them the correct answer.

Finally some additional information about food wastage is shown.</comment><data>{"commentRefs":[],"fieldData":{"~commentOffsetX":"-404","~commentOffsetY":"-25.111111111111114"}}</data><statement name="STACK"><block type="gamesetbackgroundimage" id="7$Q(Wf*.P3JQUlX|n7|p"><value name="img"><shadow type="background_image_picker" id="g]tj{nW^/E:2^[g%j95A"><field name="img">img`
